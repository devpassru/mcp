{
  "name": "@devpass/mcp",
  "version": "1.3.1",
  "description": "Unified MCP server for DevPass: RunPort tunnels, Submito forms, RunGate AI DNS/Gateway, RunPing uptime/SSL monitoring, Adopto behavioral emails, RunDeploy hosting, and Answero AI support chat",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "devpass-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "prepare": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test build/test.js",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devpassru/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/devpassru/mcp/issues"
  },
  "homepage": "https://devpass.ru",
  "keywords": [
    "mcp",
    "mcp-server",
    "devpass",
    "model-context-protocol",
    "runport",
    "submito",
    "rungate",
    "runping",
    "adopto",
    "rundeploy",
    "answero",
    "cursor",
    "claude-code",
    "windsurf"
  ],
  "author": "DevPass (https://devpass.ru)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
